PORT=5000
NODE_ENV=development

# Supabase Credentials (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Twilio Credentials (Get from Twilio Console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Option A: Twilio Verify Service (Recommended for OTP)
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
# Option B: Twilio Standard Phone Number for SMS OTP
TWILIO_PHONE_NUMBER=+1234567890

# Auth JWT Secret
JWT_SECRET=pavan_jewellers_girvi_secret_2026_key
